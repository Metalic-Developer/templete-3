          value: TextEditingValue(text: 'text'),
          pattern: '',
          start: 0,
          throws: true,
        ),

        _Example(
          'Not found -> null',
          value: TextEditingValue(text: 'text'),
          pattern: RegExp('not found'),
          start: 0,
          expected: null,
        ),

        _Example(
          'First occurrence',
          value: TextEditingValue(text: 'aba'),
