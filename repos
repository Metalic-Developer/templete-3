      #     'lib/*/*.part.dart' \
      #     'lib/generated/*.dart' \
      #     'lib/generated/*/*.dart' -o coverage/lcov.info

      - name: Codecov
        uses: codecov/codecov-action@v3
        with:
          file: coverage/lcov.info


