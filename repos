                    ),
                    decoration: BoxDecoration(
                      color: style.backgroundColor,
                      border: style.color != null
                          ? Border.all(
                              color: style.color!,
                            )
                          : null,
                    ),
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Text(
