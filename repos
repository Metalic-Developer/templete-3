    _currentStreamSubscription = null;
    _currentStreamId = null;

    // Clean up scroll state for this stream ID
    _initialScrollExtents.remove(streamId);
    _reachedTargetScroll.remove(streamId);
  }

  @override
  Widget build(BuildContext context) {
